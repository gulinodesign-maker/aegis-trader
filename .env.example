# Safe defaults: app starts in DEMO + PAPER + MANUAL.
DEMO_MODE=true
AUTH_MODE=demo
APP_ACCESS_CODE_SHA256=
APP_SESSION_SECRET=
APP_SESSION_TTL_HOURS=12
TRADING_MODE=paper
EXECUTION_MODE=MANUAL
INITIAL_CAPITAL_EUR=20

# Deterministic risk controls
MAX_RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2
MAX_TOTAL_EXPOSURE_PERCENT=100
MAX_SINGLE_POSITION_PERCENT=35
MAX_OPEN_POSITIONS=3
MIN_CASH_RESERVE_PERCENT=10
MAX_SPREAD_BPS=35
MAX_QUOTE_AGE_SECONDS=15
MAX_ATR_PERCENT=6
MIN_AVERAGE_DOLLAR_VOLUME=5000000
LOSS_STREAK_COOLDOWN_COUNT=3
LOSS_STREAK_COOLDOWN_MINUTES=60
KILL_SWITCH=false

# Live mode requires ALL of the following and valid broker credentials.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACKNOWLEDGED=false
BROKER_PROVIDER=paper
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# AI is optional; demo agent works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL is optional in demo mode.
DATABASE_URL=
DATABASE_ENCRYPTION_KEY=

# Funding. Revolut is OFF by default; personal accounts use manual SEPA flow.
FUNDING_PROVIDER=sepa
REVOLUT_BUSINESS_API_ENABLED=false
REVOLUT_BUSINESS_BASE_URL=https://b2b.revolut.com/api/1.0
REVOLUT_CLIENT_ID=
REVOLUT_ISSUER_DOMAIN=
REVOLUT_REFRESH_TOKEN=
REVOLUT_PRIVATE_KEY_PEM=

# Backtest cost assumptions (always shown separately from live/paper results).
BACKTEST_COMMISSION_PER_ORDER=0.01
BACKTEST_SLIPPAGE_BPS=5

# Optional profit sweep calculation only (no automatic transfer in V1).
PROFIT_SWEEP_ENABLED=false
PROFIT_SWEEP_THRESHOLD_EUR=100
PROFIT_SWEEP_PERCENT=25

# Scheduler auth for cron endpoints.
CRON_SECRET=
